    given-names: Kush
  - family-names: Gong
    given-names: Jian
repository-code: "https://github.com/GoJian/awg_retina_tomography_ui"
url: "https://gojian.github.io/awg_retina_tomography_ui/"
license: MIT
version: 1.0.0
date-released: "2026-09-15"
keywords:
  - micro-CT
  - visualization
  - WebGL
  - space biology
  - ophthalmology
  - open data
